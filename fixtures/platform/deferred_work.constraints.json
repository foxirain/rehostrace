{
  "schema_version": "rehostrace.schedule-constraints/v1",
  "synthesis_id": "public.deferred-work.constraints",
  "schedule_id": "public.deferred-work.schedule",
  "disclosure": "public-synthetic",
  "timeout_ms": 5000,
  "signal_order": ["worker.waiting", "free.pre", "free.done", "worker.done"],
  "identity": {"capture": "arg0", "policy": "same-across-points"},
  "points": [
    {"id": "worker.access-pre", "selector": {"kind": "symbol", "symbol": "rehostrace_deferred_worker_access_pre"}},
    {"id": "worker.access-done", "selector": {"kind": "symbol", "symbol": "rehostrace_deferred_worker_access_done"}},
    {"id": "teardown.free-pre", "selector": {"kind": "symbol", "symbol": "rehostrace_deferred_teardown_free_pre"}},
    {"id": "teardown.free-done", "selector": {"kind": "symbol", "symbol": "rehostrace_deferred_teardown_free_done"}}
  ],
  "milestones": [
    {"signal": "worker.waiting", "point": "worker.access-pre", "phase": "enter"},
    {"signal": "free.pre", "point": "teardown.free-pre", "phase": "enter"},
    {"signal": "free.done", "point": "teardown.free-done", "phase": "enter"},
    {"signal": "worker.done", "point": "worker.access-done", "phase": "enter"}
  ],
  "gates": [
    {"after_signal": "free.done", "before_release_of": "worker.access-pre"},
    {"after_signal": "worker.done", "before_release_of": "teardown.free-pre"}
  ],
  "counters": [],
  "claim_boundary": "This public schedule controls an intentionally vulnerable deferred-work fixture and carries no product claim."
}
