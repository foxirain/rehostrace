{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rehostrace:schema:replay-ablation:v1",
  "title": "RehostRace causal replay order ablation",
  "type": "object",
  "required": [
    "schema_version",
    "ablation_id",
    "trace_sha256",
    "binding_sha256",
    "policies",
    "claim_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "rehostrace.replay-ablation/v1"},
    "ablation_id": {"$ref": "#/$defs/id"},
    "trace_sha256": {"$ref": "#/$defs/sha256"},
    "binding_sha256": {"$ref": "#/$defs/sha256"},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["causal-dag", "fixed-total-order", "naive-timestamp"]},
          "action_order": {
            "type": "array",
            "items": {"$ref": "#/$defs/id"},
            "uniqueItems": true
          },
          "acknowledge_cross_domain_unsoundness": {"type": "boolean"}
        }
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
