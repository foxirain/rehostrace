{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rehostrace:schema:boundary-binding:v1",
  "title": "RehostRace causal boundary-to-adapter binding",
  "type": "object",
  "required": [
    "schema_version",
    "binding_id",
    "trace_sha256",
    "schedule_sha256",
    "adapter",
    "actions",
    "claim_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "rehostrace.binding/v1"},
    "binding_id": {"$ref": "#/$defs/id"},
    "trace_sha256": {"$ref": "#/$defs/sha256"},
    "schedule_sha256": {"$ref": "#/$defs/sha256"},
    "adapter": {"$ref": "#/$defs/id"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "event_id", "endpoint", "payload", "launch_group"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "event_id": {"$ref": "#/$defs/id"},
          "endpoint": {"type": "string", "minLength": 1},
          "launch_group": {"$ref": "#/$defs/id"},
          "start_after_signal": {"$ref": "#/$defs/id"},
          "payload": {
            "type": "object",
            "required": ["encoding", "data", "length", "sha256"],
            "additionalProperties": false,
            "properties": {
              "encoding": {"enum": ["hex", "utf8"]},
              "data": {"type": "string"},
              "length": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
