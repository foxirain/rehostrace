{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rehostrace:schema:bluetooth-protocol-pack:v1",
  "title": "RehostRace data-only Bluetooth protocol-pack manifest",
  "type": "object",
  "required": ["schema_version", "pack_id", "protocol", "layer", "requires", "selectors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "rehostrace.bluetooth-pack/v1"},
    "pack_id": {"$ref": "#/$defs/id"},
    "protocol": {"$ref": "#/$defs/id"},
    "layer": {"enum": ["controller", "link", "application"]},
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "required_attributes"],
        "additionalProperties": false,
        "properties": {
          "operation": {"$ref": "#/$defs/id"},
          "required_attributes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}
  }
}
