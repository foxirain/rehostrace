{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rehostrace:schema:schedule-search:v1",
  "title": "RehostRace bounded gate-search manifest",
  "type": "object",
  "required": [
    "schema_version",
    "search_id",
    "strategy",
    "repetitions_per_candidate",
    "base_constraints_sha256",
    "trace_sha256",
    "gate_universe",
    "candidates",
    "claim_boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "rehostrace.schedule-search/v1"},
    "search_id": {"$ref": "#/$defs/id"},
    "strategy": {"const": "exhaustive-gate-subsets"},
    "repetitions_per_candidate": {"type": "integer", "minimum": 1},
    "base_constraints_sha256": {"$ref": "#/$defs/sha256"},
    "trace_sha256": {"$ref": "#/$defs/sha256"},
    "gate_universe": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}::[a-z0-9][a-z0-9._:-]{0,127}$"}
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "enabled_gates",
          "disabled_gates",
          "gate_count",
          "constraints_sha256",
          "schedule_sha256",
          "binding_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {"$ref": "#/$defs/id"},
          "enabled_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "disabled_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "gate_count": {"type": "integer", "minimum": 0},
          "constraints_sha256": {"$ref": "#/$defs/sha256"},
          "schedule_sha256": {"$ref": "#/$defs/sha256"},
          "binding_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
