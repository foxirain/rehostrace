{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rehostrace.example/schemas/capture_bundle.schema.json",
  "title": "RehostRace boundary capture bundle",
  "type": "object",
  "required": ["schema_version", "capture_id", "disclosure", "clock_domains", "actors", "records"],
  "properties": {
    "schema_version": {"const": "rehostrace.capture-bundle/v1"},
    "capture_id": {"type": "string", "minLength": 1},
    "disclosure": {"enum": ["public-synthetic", "public-redacted", "private-product", "vendor-approved"]},
    "producer": {"type": "string"},
    "redactions": {"type": "array", "items": {"type": "string"}},
    "clock_domains": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "actors": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "resources": {"type": "array", "items": {"type": "object"}},
    "records": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"type": "object"}}
  },
  "additionalProperties": false
}
